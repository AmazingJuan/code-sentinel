{
  "name": "@amazingwalin/code-sentinel-cli",
  "version": "0.5.1",
  "description": "Official CLI for Code Sentinel AppSec and vulnerability management platform",
  "keywords": [
    "security",
    "appsec",
    "sast",
    "secret-scanning",
    "semgrep",
    "opengrep",
    "gitleaks",
    "vulnerability-management",
    "cli",
    "code-sentinel"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/AmazingJuan/code-sentinel.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/AmazingJuan/code-sentinel/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/AmazingJuan/code-sentinel/issues"
  },
  "bin": {
    "code-sentinel": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run test/e2e.spec.ts",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
