# PostgreSQL Database Configuration
POSTGRES_DB=code_sentinel
POSTGRES_USER=code_sentinel
POSTGRES_PASSWORD=code_sentinel
DB_HOST=localhost
DB_PORT=5432
# Managed hosting alternative to the DB_* variables above (takes precedence; enables TLS).
# DATABASE_URL=postgres://user:password@host:5432/code_sentinel
# Force TLS when using the discrete DB_* variables.
# DB_SSL=false
# Schema auto-sync. Defaults to true outside production and false in production;
# set it explicitly to true until a migration strategy exists.
DB_SYNCHRONIZE=true

# Backend Authentication & Security
# JWT_SECRET is required when NODE_ENV=production (startup fails without it); use a strong random value.
JWT_SECRET=development-only-secret
JWT_EXPIRES_IN=7d

# Backend HTTP
# PORT=3000
# Comma-separated browser origins allowed by CORS. Empty allows every origin (development only).
CORS_ORIGINS=

# API URL for Frontend & CLI
CODE_SENTINEL_API_URL=http://localhost:8000
